{
  "expo": {
    "name": "AquaGo Worker",
    "slug": "aquago-worker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10213F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquago.worker"
    },
    "android": {
      "package": "com.aquago.worker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10213F"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AquaGo Worker to broadcast live GPS location to customer and admin while en route to a service booking."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AquaGo Worker to take before and after wash inspection photos."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:5000/api/v1",
      "localApiUrl": "http://127.0.0.1:5000/api/v1"
    }
  }
}
