{
  "name": "aquago-wash-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/customer/vite.config.js --port 5173",
    "dev:customer": "vite --config apps/customer/vite.config.js --port 5173",
    "dev:worker": "vite --config apps/worker/vite.config.js --port 5174",
    "dev:admin": "vite --config apps/admin/vite.config.js --port 5175",
    "build": "npm run build:all",
    "build:customer": "vite build --config apps/customer/vite.config.js",
    "build:worker": "vite build --config apps/worker/vite.config.js",
    "build:admin": "vite build --config apps/admin/vite.config.js",
    "build:all": "npm run build:customer && npm run build:worker && npm run build:admin",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
